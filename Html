 </div>

 <!-- RGB CONTROL -->

 <div class="bottom-panel">

  <div class="panel">
   <div class="section-label">RGB LIGHTING</div>

   <div class="controls" style="justify-content:flex-start;margin:0">
    <button class="btn" id="rgbBtn" onclick="toggleRGB()">🌈 RGB OFF</button>
    <button class="btn selected" onclick="setColor('#b6ff52',this)">
     <span class="color-dot" style="background:#b6ff52"></span>GREEN
    </button>
    <button class="btn" onclick="setColor('#52edff',this)">
     <span class="color-dot" style="background:#52edff"></span>BLUE
    </button>
    <button class="btn" onclick="setColor('#bd72ff',this)">
     <span class="color-dot" style="background:#bd72ff"></span>PURPLE
    </button>
    <button class="btn" onclick="setColor('#ff72b6',this)">
     <span class="color-dot" style="background:#ff72b6"></span>PINK
    </button>
   </div>
  </div>

  <div class="panel">
   <div class="section-label">VAXOR PERFORMANCE MODE</div>
   <p>
    Activa la experiencia gaming completa:
    iluminación RGB, efectos neón y una interfaz
    diseñada para los gamers.
   </p>
   <button class="btn primary" style="margin-top:12px" id="performanceBtn" onclick="togglePerformance()">
    ⚡ ACTIVATE PERFORMANCE
   </button>
  </div>

 </div>

 <p class="subtitle" style="text-align:center;margin-top:22px">
  Press any physical key to illuminate it.
 </p>

</section>

<!-- RESULTS -->

<section class="screen" id="results">

 <div class="intro">
  <div class="tag">TEST COMPLETED</div>
  <h1>YOUR <span>RESULTS.</span></h1>
  <p class="subtitle">KEYTEST PRO PERFORMANCE REPORT</p>
 </div>

 <div class="score-circle">
  <strong id="finalScore">0</strong>
  <small>OUT OF 100</small>
 </div>

 <div class="result-text" id="resultMessage"></div>

 <div class="stats">
  <div class="stat">
   <small>TESTED KEYS</small>
   <strong id="finalKeys">0</strong>
  </div>
  <div class="stat">
   <small>KEY PRESSES</small>
   <strong id="finalPresses">0</strong>
  </div>
  <div class="stat">
   <small>LAYOUT</small>
   <strong id="finalLayout">AZERTY</strong>
  </div>
  <div class="stat">
   <small>COMPLETION</small>
   <strong id="finalPercent">0%</strong>
  </div>
 </div>

 <div class="controls">
  <button class="btn primary" onclick="resetTest();showScreen('test')">
   REPEAT TEST ↻
  </button>
  <button class="btn" onclick="backHome()">HOME</button>
 </div>

</section>

<footer>
 KEYTEST PRO 2.0 · POWERED BY VAXOR · 2026
</footer>

<script>

/* KEYBOARD LAYOUTS
   Physical codes use KeyboardEvent.code.
*/

const layouts={

AZERTY:[
[
['²','Backquote'],['1','Digit1'],['2','Digit2'],
['3','Digit3'],['4','Digit4'],['5','Digit5'],
['6','Digit6'],['7','Digit7'],['8','Digit8'],
['9','Digit9'],['0','Digit0'],['°','Minus'],
['+','Equal'],['BACKSPACE','Backspace','w2']
],
[
['TAB','Tab','w15'],['A','KeyQ'],['Z','KeyW'],
['E','KeyE'],['R','KeyR'],['T','KeyT'],
['Y','KeyY'],['U','KeyU'],['I','KeyI'],
['O','KeyO'],['P','KeyP'],['^','BracketLeft'],
['$','BracketRight'],['ENTER','Enter','w2']
],
[
['CAPS','CapsLock','w175'],['Q','KeyA'],['S','KeyS'],
['D','KeyD'],['F','KeyF'],['G','KeyG'],
['H','KeyH'],['J','KeyJ'],['K','KeyK'],
['L','KeyL'],['M','Semicolon'],['ù','Quote'],
['*','Backslash']
],
[
['SHIFT','ShiftLeft','w225'],['<','IntlBackslash'],
['W','KeyZ'],['X','KeyX'],['C','KeyC'],
['V','KeyV'],['B','KeyB'],['N','KeyN'],
[',','Comma'],[';','Period'],[':','Slash'],
['SHIFT','ShiftRight','w275']
],
[
['CTRL','ControlLeft','w15'],['WIN','MetaLeft'],
['ALT','AltLeft'],['SPACE','Space','space'],
['ALT GR','AltRight'],['MENU','ContextMenu'],
['CTRL','ControlRight','w15']
]
],

QWERTY:[
[
['`','Backquote'],['1','Digit1'],['2','Digit2'],
['3','Digit3'],['4','Digit4'],['5','Digit5'],
['6','Digit6'],['7','Digit7'],['8','Digit8'],
['9','Digit9'],['0','Digit0'],['-','Minus'],
['=','Equal'],['BACKSPACE','Backspace','w2']
],
[
['TAB','Tab','w15'],['Q','KeyQ'],['W','KeyW'],
['E','KeyE'],['R','KeyR'],['T','KeyT'],
['Y','KeyY'],['U','KeyU'],['I','KeyI'],
['O','KeyO'],['P','KeyP'],['[','BracketLeft'],
[']','BracketRight'],['\\','Backslash']
],
[
['CAPS','CapsLock','w175'],['A','KeyA'],['S','KeyS'],
['D','KeyD'],['F','KeyF'],['G','KeyG'],
['H','KeyH'],['J','KeyJ'],['K','KeyK'],
['L','KeyL'],[';','Semicolon'],["'",'Quote'],
['ENTER','Enter','w2']
],
[
['SHIFT','ShiftLeft','w225'],['Z','KeyZ'],['X','KeyX'],
['C','KeyC'],['V','KeyV'],['B','KeyB'],
['N','KeyN'],['M','KeyM'],[',','Comma'],
['.','Period'],['/','Slash'],['SHIFT','ShiftRight','w275']
],
[
['CTRL','ControlLeft','w15'],['WIN','MetaLeft'],
['ALT','AltLeft'],['SPACE','Space','space'],
['ALT GR','AltRight'],['MENU','ContextMenu'],
['CTRL','ControlRight','w15']
]
]

};

/* STATE */

let currentLayout='AZERTY';
let tested=new Set();
let pressed=new Set();
let pressCount=0;
let history=[];
let rgb=false;
let performance=false;

const totalKeys=()=>layouts[currentLayout].flat().length;

/* SCREEN */

function showScreen(id){
 document.querySelectorAll('.screen').forEach(s=>{
  s.classList.remove('active');
 });
 document.getElementById(id).classList.add('active');
}

/* START */

function startTest(layout){
 currentLayout=layout;
 tested.clear();
 pressed.clear();
 pressCount=0;
 history=[];

 document.getElementById('layoutName').textContent=layout;

 buildKeyboard();
 updateDashboard();
 updateHistory();
 showScreen('test');
}

/* BUILD KEYBOARD */

function buildKeyboard(){
 const keyboard=document.getElementById('keyboard');
 keyboard.innerHTML='';

 layouts[currentLayout].forEach(row=>{
  const rowElement=document.createElement('div');
  rowElement.className='key-row';

  row.forEach(([label,code,size])=>{
   const key=document.createElement('div');
   key.className='key '+(size||'');
   key.textContent=label;
   key.dataset.code=code;

   rowElement.appendChild(key);
  });

  keyboard.appendChild(rowElement);
 });

}

/* KEY EVENTS */

function pressKey(code){

 if(!code)return;

 const key=[...document.querySelectorAll('.key')]
  .find(k=>k.dataset.code===code);

 if(!key)return;

 key.classList.add('active','tested');

 if(!tested.has(code)){
  tested.add(code);
 }

 pressed.add(code);
 pressCount++;

 const label=key.textContent;

 document.getElementById('lastKey').textContent=label;

 history.unshift(label);
 history=history.slice(0,10);

 updateHistory();
 updateDashboard();

}

function releaseKey(code){

 const key=[...document.querySelectorAll('.key')]
  .find(k=>k.dataset.code===code);

 if(key)key.classList.remove('active');

 pressed.delete(code);

}

/* PHYSICAL INPUT */

document.addEventListener('keydown',event=>{

 if(!document.getElementById('test').classList.contains('active'))return;

 if(event.repeat)return;

 event.preventDefault();
 pressKey(event.code);

});

document.addEventListener('keyup',event=>{
 releaseKey(event.code);
});

window.addEventListener('blur',()=>{
 pressed.forEach(code=>releaseKey(code));
});

/* DASHBOARD */

function updateDashboard(){

 const total=totalKeys();
 const count=tested.size;
 const percent=Math.round(count/total*100);

 document.getElementById('testedCount').textContent=count;
 document.getElementById('percentage').textContent=percent+'%';
 document.getElementById('pressCount').textContent=pressCount;
 document.getElementById('score').textContent=percent+'/100';

 document.getElementById('progressBar').style.width=percent+'%';

}

function updateHistory(){

 const box=document.getElementById('history');
 box.innerHTML='';

 if(history.length===0){
  box.innerHTML='<span style="color:#82918a;font-size:11px">Waiting for input...</span>';
  return;
 }

 history.forEach(label=>{
  const item=document.createElement('span');
  item.className='history-key';
  item.textContent=label;
  box.appendChild(item);
 });

}

/* RGB */

function toggleRGB(){

 rgb=!rgb;
 document.body.classList.toggle('rgb-mode',rgb);

 document.getElementById('rgbBtn').textContent=
  rgb?'🌈 RGB ON':'🌈 RGB OFF';

}

function setColor(color,button){

 document.documentElement.style.setProperty('--glow',color);

 document.querySelectorAll('.bottom-panel .btn').forEach(btn=>{
  if(btn.textContent.includes('GREEN')||
     btn.textContent.includes('BLUE')||
     btn.textContent.includes('PURPLE')||
     btn.textContent.includes('PINK')){
   btn.classList.remove('selected');
  }
 });

 button.classList.add('selected');

}

/* PERFORMANCE MODE */

function togglePerformance(){

 performance=!performance;

 if(performance){
  rgb=true;
  document.body.classList.add('rgb-mode');
  document.documentElement.style.setProperty('--glow','#b6ff52');
  document.getElementById('rgbBtn').textContent='🌈 RGB ON';
  document.getElementById('performanceBtn').textContent='⚡ DEACTIVATE PERFORMANCE';
  document.getElementById('performanceBtn').classList.remove('primary');
 }else{
  rgb=false;
  document.body.classList.remove('rgb-mode');
  document.getElementById('rgbBtn').textContent='🌈 RGB OFF';
  document.getElementById('performanceBtn').textContent='⚡ ACTIVATE PERFORMANCE';
  document.getElementById('performanceBtn').classList.add('primary');
 }

}

/* RESET */

function resetTest(){

 tested.clear();
 pressed.clear();
 history=[];
 pressCount=0;

 document.querySelectorAll('.key').forEach(key=>{
  key.classList.remove('active','tested');
 });

 document.getElementById('lastKey').textContent='---';

 updateHistory();
 updateDashboard();

}

/* RESULTS */

function showResults(){

 const total=totalKeys();
 const count=tested.size;
 const percent=Math.round(count/total*100);

 document.getElementById('finalScore').textContent=percent;
 document.getElementById('finalKeys').textContent=count;
 document.getElementById('finalPresses').textContent=pressCount;
 document.getElementById('finalLayout').textContent=currentLayout;
 document.getElementById('finalPercent').textContent=percent+'%';

 let message='Has probado '+count+' de '+total+' teclas visibles.';

 if(percent===100){
  message='¡PERFECT SCORE! Has probado todas las teclas del teclado virtual.';
 }else if(percent>=70){
  message='¡Buen trabajo! Has probado la mayor parte de tu teclado.';
 }else if(percent>=30){
  message='Buen comienzo. Todavía quedan teclas por probar.';
 }else{
  message='Sigue probando teclas para completar tu test.';
 }

 document.getElementById('resultMessage').textContent=message;

 showScreen('results');

}

/* HOME */

function backHome(){
 pressed.clear();
 showScreen('home');
}

</script>

