<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>KEYTEST PRO 2.0 | VAXOR</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

:root{
 --bg:#080b0c;
 --panel:#111817;
 --panel2:#17211e;
 --green:#b6ff52;
 --text:#f3f7f2;
 --muted:#82918a;
 --glow:#b6ff52;
}

*{box-sizing:border-box;margin:0;padding:0}

body{
 background:var(--bg);
 color:var(--text);
 font-family:Inter,sans-serif;
 min-height:100vh;
 overflow-x:hidden;
}

body:before{
 content:"";
 position:fixed;
 width:600px;height:600px;
 background:#aaff2510;
 filter:blur(130px);
 top:-250px;left:30%;
 pointer-events:none;
 z-index:-1;
}

header{
 height:76px;
 padding:0 5%;
 display:flex;
 align-items:center;
 justify-content:space-between;
 border-bottom:1px solid #ffffff13;
}

.logo{
 font-size:23px;
 font-weight:900;
 letter-spacing:-1px;
}

.logo span{color:var(--green)}

.header-status{
 color:var(--muted);
 font-size:10px;
 letter-spacing:2px;
}

.screen{
 display:none;
 max-width:1250px;
 padding:55px 4%;
 margin:auto;
}

.screen.active{display:block}

.tag{
 display:inline-block;
 color:var(--green);
 border:1px solid #b6ff5240;
 padding:8px 14px;
 border-radius:30px;
 font-size:9px;
 font-weight:900;
 letter-spacing:2px;
 margin-bottom:18px;
}

.intro{text-align:center;margin-bottom:38px}

h1{
 font-size:clamp(38px,7vw,68px);
 letter-spacing:-4px;
 font-weight:900;
}

h1 span{color:var(--green)}

.subtitle{
 color:var(--muted);
 font-size:13px;
 line-height:1.8;
 margin-top:13px;
}

/* SPONSOR */

.sponsor{
 max-width:850px;
 min-height:155px;
 margin:0 auto 42px;
 padding:25px 32px;
 display:flex;
 align-items:center;
 justify-content:space-between;
 gap:20px;
 position:relative;
 overflow:hidden;
 border:1px solid #b6ff5240;
 border-radius:16px;
 background:
 radial-gradient(ellipse at 85% 50%,#b6ff5225,transparent 60%),
 linear-gradient(110deg,#080d0b,#111a13);
}

.sponsor:before{
 content:"";
 position:absolute;
 top:0;left:0;
 width:4px;height:100%;
 background:var(--green);
 box-shadow:0 0 20px var(--green);
}

.sponsor-label{
 font-size:9px;
 color:var(--green);
 letter-spacing:4px;
 font-weight:900;
 margin-bottom:12px;
}

.sponsor h3{font-size:23px;font-weight:900}

.sponsor p{
 font-size:11px;
 color:var(--muted);
 margin-top:7px;
}

.sponsor-logo{
 color:var(--green);
 font-size:clamp(30px,5vw,48px);
 font-weight:900;
 font-style:italic;
 letter-spacing:-3px;
 text-shadow:0 0 25px #b6ff5270;
}

.sponsor-btn{
 display:inline-block;
 margin-top:13px;
 padding:10px 17px;
 border-radius:5px;
 background:var(--green);
 color:#10150b;
 text-decoration:none;
 font-size:10px;
 font-weight:900;
}

/* HOME */

.choice-title{
 text-align:center;
 font-size:12px;
 color:var(--muted);
 margin-bottom:20px;
}

.choices{
 display:flex;
 justify-content:center;
 gap:18px;
 flex-wrap:wrap;
}

.choice{
 width:245px;
 padding:27px;
 border-radius:15px;
 border:1px solid #ffffff17;
 background:var(--panel);
 cursor:pointer;
 transition:.25s;
}

.choice:hover{
 transform:translateY(-5px);
 border-color:var(--green);
 box-shadow:0 0 30px #b6ff5215;
}

.flag{font-size:30px;margin-bottom:18px}
.choice h2{font-size:25px}
.choice p{font-size:11px;color:var(--muted);margin-top:8px}
.arrow{color:var(--green);font-size:11px;font-weight:900;margin-top:23px}

/* DASHBOARD */

.dashboard-title{
 display:flex;
 align-items:center;
 justify-content:space-between;
 flex-wrap:wrap;
 gap:15px;
 margin-bottom:20px;
}

.dashboard-title h2{font-size:23px}
.dashboard-title h2 span{color:var(--green)}

.live{
 display:flex;
 align-items:center;
 gap:7px;
 color:#b6ff52;
 font-size:10px;
 font-weight:900;
 letter-spacing:2px;
}

.live-dot{
 width:8px;height:8px;
 background:var(--green);
 border-radius:50%;
 box-shadow:0 0 12px var(--green);
 animation:pulse 1s infinite;
}

@keyframes pulse{
 50%{opacity:.3;transform:scale(.75)}
}

.stats{
 display:grid;
 grid-template-columns:repeat(4,1fr);
 gap:12px;
 margin-bottom:17px;
}

.stat{
 padding:17px;
 background:var(--panel);
 border:1px solid #ffffff12;
 border-radius:11px;
 min-width:0;
}

.stat small{
 display:block;
 font-size:9px;
 color:var(--muted);
 letter-spacing:1px;
 margin-bottom:10px;
}

.stat strong{
 font-size:24px;
 color:var(--green);
}

.progress{
 height:5px;
 background:#202a27;
 border-radius:20px;
 overflow:hidden;
 margin-bottom:22px;
}

.progress-bar{
 height:100%;
 width:0%;
 background:var(--green);
 box-shadow:0 0 12px var(--green);
 transition:.3s;
}

/* MONITOR */

.monitor{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:12px;
 margin-bottom:18px;
}

.monitor-card{
 background:var(--panel);
 border:1px solid #ffffff13;
 padding:18px;
 border-radius:12px;
 min-height:120px;
}

.monitor-label{
 color:var(--muted);
 font-size:9px;
 letter-spacing:2px;
 font-weight:800;
 margin-bottom:15px;
}

.last-key{
 font-size:35px;
 font-weight:900;
 color:var(--green);
 text-shadow:0 0 20px #b6ff5250;
}

.history{
 display:flex;
 flex-wrap:wrap;
 gap:7px;
}

.history-key{
 background:#26322d;
 color:var(--green);
 padding:8px 10px;
 border-radius:5px;
 font-size:11px;
 font-weight:800;
}

/* KEYBOARD */

.keyboard-container{
 background:linear-gradient(145deg,#121b19,#0a100f);
 border:1px solid #ffffff17;
 border-radius:17px;
 padding:23px 14px;
 overflow-x:auto;
 box-shadow:0 20px 60px #0008;
}

.keyboard{
 min-width:850px;
 max-width:1050px;
 margin:auto;
}

.key-row{
 display:flex;
 justify-content:center;
 gap:5px;
 margin-bottom:6px;
}

.key{
 flex:1;
 min-width:0;
 height:52px;
 border:1px solid #ffffff13;
 border-bottom:4px solid #080c0b;
 border-radius:7px;
 background:linear-gradient(145deg,#28332f,#151d1a);
 display:flex;
 justify-content:center;
 align-items:center;
 position:relative;
 color:#d3ddd5;
 font-size:12px;
 font-weight:800;
 transition:.12s;
 user-select:none;
}

.key.w125{flex:1.25}
.key.w15{flex:1.5}
.key.w175{flex:1.75}
.key.w2{flex:2}
.key.w225{flex:2.25}
.key.w275{flex:2.75}
.key.space{flex:6}

.key.active{
 background:var(--glow);
 color:#10160b;
 border-color:var(--glow);
 box-shadow:0 0 12px var(--glow),0 0 30px var(--glow);
 transform:translateY(2px);
 border-bottom-width:2px;
}

.key.tested:not(.active){
 color:var(--glow);
 border-color:var(--glow);
}

.key small{
 position:absolute;
 top:4px;left:5px;
 font-size:7px;
 color:#89968e;
}

.key.active small{color:#26351a}

/* RGB MODE */

body.rgb-mode .key.tested:not(.active){
 animation:rgbGlow 3s linear infinite;
}

@keyframes rgbGlow{
 0%{color:#b6ff52;border-color:#b6ff52}
 25%{color:#52edff;border-color:#52edff}
 50%{color:#bd72ff;border-color:#bd72ff}
 75%{color:#ff72b6;border-color:#ff72b6}
 100%{color:#b6ff52;border-color:#b6ff52}
}

/* CONTROLS */

.controls{
 display:flex;
 justify-content:center;
 flex-wrap:wrap;
 gap:10px;
 margin:20px 0;
}

.btn{
 border:1px solid #ffffff20;
 background:var(--panel);
 color:white;
 border-radius:7px;
 padding:13px 18px;
 font-size:10px;
 font-weight:900;
 cursor:pointer;
 transition:.2s;
}

.btn:hover{border-color:var(--green)}

.btn.primary{
 background:var(--green);
 color:#10150b;
 border-color:var(--green);
}

.btn.primary:hover{box-shadow:0 0 20px #b6ff5260}

.btn.selected{
 border-color:var(--green);
 color:var(--green);
}

.section-label{
 font-size:10px;
 color:var(--muted);
 letter-spacing:2px;
 font-weight:900;
 margin-bottom:12px;
}

.color-dot{
 width:13px;height:13px;
 border-radius:50%;
 display:inline-block;
 margin-right:6px;
 vertical-align:middle;
}

.bottom-panel{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:15px;
 margin-top:22px;
}

.panel{
 background:var(--panel);
 border:1px solid #ffffff13;
 padding:17px;
 border-radius:12px;
}

.panel p{
 font-size:11px;
 color:var(--muted);
 line-height:1.7;
}

/* RESULTS */

.score-circle{
 width:155px;height:155px;
 margin:25px auto;
 border-radius:50%;
 border:6px solid var(--green);
 box-shadow:0 0 35px #b6ff5230,inset 0 0 25px #b6ff5210;
 display:flex;
 flex-direction:column;
 align-items:center;
 justify-content:center;
}

.score-circle strong{
 font-size:44px;
 color:var(--green);
}

.score-circle small{
 font-size:9px;
 color:var(--muted);
 letter-spacing:2px;
}

.result-text{
 text-align:center;
 color:var(--muted);
 font-size:12px;
 line-height:1.8;
 margin-bottom:25px;
}

footer{
 text-align:center;
 padding:30px;
 border-top:1px solid #ffffff10;
 color:#59665f;
 font-size:9px;
 letter-spacing:2px;
 margin-top:45px;
}

@media(max-width:750px){
 .stats{grid-template-columns:repeat(2,1fr)}
 .monitor{grid-template-columns:1fr 1fr}
}

@media(max-width:500px){
 header{padding:0 4%}
 .header-status{font-size:8px}
 .screen{padding:40px 4%}
 .sponsor{padding:22px;flex-wrap:wrap}
 .choice{width:100%}
 .monitor{grid-template-columns:1fr}
 .bottom-panel{grid-template-columns:1fr}
 .stat strong{font-size:21px}
}
</style>
</head>

<body>

<header>
 <div class="logo">KEY<span>TEST</span> PRO</div>
 <div class="header-status">VAXOR GAMING LAB / 02.0</div>
</header>

<!-- HOME -->

<section class="screen active" id="home">

 <div class="intro">
  <div class="tag">VAXOR GAMING TECHNOLOGY</div>
  <h1>TEST YOUR <span>KEYBOARD.</span></h1>
  <p class="subtitle">
   Your keyboard. Your performance. Your test.<br>
   Comprueba todas tus teclas en tiempo real.
  </p>
 </div>

 <div class="sponsor">
  <div>
   <div class="sponsor-label">OFFICIAL GAMING PARTNER</div>
   <h3>BUILT FOR GAMERS.</h3>
   <p>Discover the next generation of gaming gear.</p>
   <a class="sponsor-btn" href="https://example.com" target="_blank">
    VISIT VAXOR ↗
   </a>
  </div>
  <div class="sponsor-logo">VAXOR®</div>
 </div>

 <div class="choice-title">SELECT YOUR KEYBOARD LAYOUT</div>

 <div class="choices">
  <div class="choice" onclick="startTest('AZERTY')">
   <div class="flag">🇫🇷</div>
   <h2>AZERTY</h2>
   <p>French keyboard layout</p>
   <div class="arrow">START TEST →</div>
  </div>

  <div class="choice" onclick="startTest('QWERTY')">
   <div class="flag">🇬🇧</div>
   <h2>QWERTY</h2>
   <p>International keyboard layout</p>
   <div class="arrow">START TEST →</div>
  </div>
 </div>

</section>

<!-- TEST -->

<section class="screen" id="test">

 <div class="dashboard-title">
  <h2>KEYBOARD <span id="layoutName">AZERTY</span></h2>
  <div class="live"><span class="live-dot"></span> LIVE MONITOR</div>
 </div>

 <div class="stats">
  <div class="stat">
   <small>TESTED KEYS</small>
   <strong id="testedCount">0</strong>
  </div>
  <div class="stat">
   <small>PROGRESS</small>
   <strong id="percentage">0%</strong>
  </div>
  <div class="stat">
   <small>KEY PRESSES</small>
   <strong id="pressCount">0</strong>
  </div>
  <div class="stat">
   <small>TEST SCORE</small>
   <strong id="score">0/100</strong>
  </div>
 </div>

 <div class="progress">
  <div class="progress-bar" id="progressBar"></div>
 </div>

 <!-- LIVE MONITOR -->

 <div class="monitor">

  <div class="monitor-card">
   <div class="monitor-label">LAST KEY DETECTED</div>
   <div class="last-key" id="lastKey">---</div>
  </div>

  <div class="monitor-card">
   <div class="monitor-label">RECENT KEY HISTORY</div>
   <div class="history" id="history">
    <span style="color:#82918a;font-size:11px">Waiting for input...</span>
   </div>
  </div>

 </div>

 <!-- KEYBOARD -->

 <div class="keyboard-container">
  <div class="keyboard" id="keyboard"></div>
 </div>

 <div class="controls">
  <button class="btn" onclick="resetTest()">↻ RESET TEST</button>
  <button class="btn" onclick="backHome()">← HOME</button>
